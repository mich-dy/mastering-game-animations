# Application viewer config file
version: 13.0

settings:
  near-clip-plane: 0.1
  far-clip-plane: 500
  orth-nearfar-clip-plane: 40
  selected-model: 1
  selected-instance: 0
  selected-camera: 0
  selected-level: 1
  selected-dynamic-light: 0
  highlight-selection: false
  collision-enabled: 0
  interaction-enabled: false
  interaction-min-range: 1.5
  interaction-max-range: 10
  interaction-fov: 45
  level-collision-ground-slope: 0
  level-collision-max-stairstep-height: 1
  inverse-kinematics-enabled: false
  inverse-kinematics-iterations: 10
  navigation-enabled: false
  skybox-enabled: true
  fog-density: 0.004
  light-source-angle-east-west: 90
  light-source-angle-north-south: 94.26
  light-source-intensity: 0.21
  light-source-color: [1, 0.87, 0.75]
  time-of-day-enabled: false
  time-of-day-scaling: 10
  time-of-day-preset: 3
  ssao-enabled: false
  ssao-radius: 5
  ssao-bias: 0.1
  ssao-exponent: 4
  ssao-blur-enabled: true
  ssao-blur-radius: 3
  shadowmap-enabled: false
  shadowmap-split-lambda: 0.867
  shadowmap-constant-bias: 1.25
  shadowmap-slope-bias: 1.75
  shadowmap-pcf-enabled: false
  shadowmap-pcf-scale: 1
  shadowmap-pcf-range: 1

levels:
  - level-name: de_dust.glb
    level-file: assets/level/de_dust.glb
    position: [0, 0, 0]
    rotation: [0, 0, 0]
    scale: 1
    swap-axes: false

cameras:
  - camera-name: FreeCam
    position: [10.733861, 17.595587, 15.482038]
    view-azimuth: 339.3883
    view-elevation: -47.199768
    camera-type: 0
    camera-projection: 0
    field-of-view: 89

models:
  - model-name: box.glb
    model-file: assets/box/box.glb
    is-nav-target: false
    forward-speed-factor: 4
    physics-enabled: true
    physics-hull-type: 0
    physics-hull-size: [0.5, 0.5, 0.5]
    physics-hull-offset: [0, 0, 0]
    physics-hull-rotation: [0, 0, 0]
    physics-hull-scale: [1, 1, 1]
    physics-body-type: 2
    physics-friction-coeff: 1
    physics-restitution-coeff: 0.2
    physics-rolling-resistance: 0
  - model-name: box2.glb
    model-file: assets/box/box2.glb
    is-nav-target: false
    forward-speed-factor: 4
    physics-enabled: true
    physics-hull-type: 0
    physics-hull-size: [1, 1, 1]
    physics-hull-offset: [0, 0, 0]
    physics-hull-rotation: [0, 0, 0]
    physics-hull-scale: [1, 1, 1]
    physics-body-type: 2
    physics-friction-coeff: 0.8
    physics-restitution-coeff: 0.5
    physics-rolling-resistance: 0
  - model-name: sphere.glb
    model-file: assets/sphere/sphere.glb
    is-nav-target: false
    forward-speed-factor: 4
    physics-enabled: true
    physics-hull-type: 2
    physics-hull-size: [1, 1, 1]
    physics-hull-offset: [0, 0, 0]
    physics-hull-rotation: [0, 0, 0]
    physics-hull-scale: [1, 1, 1]
    physics-body-type: 2
    physics-friction-coeff: 1
    physics-restitution-coeff: 0.7
    physics-rolling-resistance: 0.25

node-trees:
  []

instances:
  - model-file: box.glb
    position: [5, 11, 7]
    rotation: [-50.634575, 0, -1.5144284]
    scale: 1
    swap-axes: false
    1st-anim-clip-number: 0
    2nd-anim-clip-number: 0
    anim-clip-speed: 1
    anim-blend-factor: 0
    enable-navigation: false
    path-target-instance: -1
  - model-file: box2.glb
    position: [8, 12, 7]
    rotation: [-28.856207, 0, 31.585093]
    scale: 0.5
    swap-axes: false
    1st-anim-clip-number: 0
    2nd-anim-clip-number: 0
    anim-clip-speed: 1
    anim-blend-factor: 0
    enable-navigation: false
    path-target-instance: -1
  - model-file: sphere.glb
    position: [11, 10, 4]
    rotation: [0, 0, 0]
    scale: 1
    swap-axes: false
    1st-anim-clip-number: 0
    2nd-anim-clip-number: 0
    anim-clip-speed: 1
    anim-blend-factor: 0
    enable-navigation: false
