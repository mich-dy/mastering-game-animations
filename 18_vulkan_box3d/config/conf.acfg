# Application viewer config file
version: 13.0

settings:
  near-clip-plane: 0.4
  far-clip-plane: 1000
  orth-nearfar-clip-plane: 40
  selected-model: 1
  selected-instance: 3
  selected-camera: 0
  selected-level: 1
  selected-dynamic-light: 0
  highlight-selection: false
  collision-enabled: 0
  interaction-enabled: false
  interaction-min-range: 1.5
  interaction-max-range: 10
  interaction-fov: 45
  gravity-enabled: false
  level-collision-ground-slope: 0
  level-collision-max-stairstep-height: 1
  inverse-kinematics-enabled: false
  inverse-kinematics-iterations: 10
  navigation-enabled: false
  skybox-enabled: true
  fog-density: 0.004
  light-source-angle-east-west: 90
  light-source-angle-north-south: 94.26
  light-source-intensity: 0.21
  light-source-color: [1, 0.87, 0.75]
  time-of-day-enabled: false
  time-of-day-scaling: 10
  time-of-day-preset: 3
  ssao-enabled: false
  ssao-radius: 5
  ssao-bias: 0.1
  ssao-exponent: 4
  ssao-blur-enabled: true
  ssao-blur-radius: 3
  shadowmap-enabled: false
  shadowmap-split-lambda: 0.867
  shadowmap-constant-bias: 1.25
  shadowmap-slope-bias: 1.75
  shadowmap-pcf-enabled: false
  shadowmap-pcf-scale: 1
  shadowmap-pcf-range: 1

levels:
  - level-name: de_dust.glb
    level-file: assets/level/de_dust.glb
    position: [0, 0, 0]
    rotation: [0, 0, 0]
    scale: 5
    swap-axes: false

cameras:
  - camera-name: FreeCam
    position: [60.4141, 91.59671, 59.866478]
    view-azimuth: 322.8887
    view-elevation: -46.999752
    camera-type: 0
    camera-projection: 0
    field-of-view: 89

