# Application viewer config file
version: 13.0

settings:
  near-clip-plane: 0.4
  far-clip-plane: 1000
  orth-nearfar-clip-plane: 40
  selected-model: 5
  selected-instance: 15
  selected-camera: 0
  selected-level: 0
  selected-dynamic-light: 0
  highlight-selection: false
  collision-enabled: 0
  interaction-enabled: false
  interaction-min-range: 1.5
  interaction-max-range: 10
  interaction-fov: 45
  gravity-enabled: false
  level-collision-ground-slope: 0
  level-collision-max-stairstep-height: 1
  inverse-kinematics-enabled: false
  inverse-kinematics-iterations: 10
  navigation-enabled: false
  skybox-enabled: true
  fog-density: 0.004
  light-source-angle-east-west: 90
  light-source-angle-north-south: 94.26
